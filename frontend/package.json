{
  "name": "datasette-paper-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"const fs=require('node:fs');fs.rmSync('../datasette_paper/static/gen',{recursive:true,force:true});fs.rmSync('../datasette_paper/manifest.json',{force:true});fs.rmSync('../datasette_paper/static/manifest.json',{force:true})\"",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.{ts,svelte}'",
    "lint:fix": "eslint --fix 'src/**/*.{ts,svelte}'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.1",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.5.0",
    "jsdom": "^26.0.0",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.43.8",
    "svelte-check": "^4.3.4",
    "svelte-eslint-parser": "^1.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^7.2.4",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "prosemirror-collab": "^1.3.1",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-example-setup": "^1.2.3",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.4",
    "prosemirror-menu": "^1.3.2",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.41.8"
  }
}
